# Release configuration for Scripts/release.sh. Copy to .env, which is gitignored.
#
# Nothing secret belongs in here. The signing key lives in the keychain and the
# notarisation password lives in a keychain profile; this file only names them.

# Must match a "Developer ID Application" identity in your keychain.
#   security find-identity -v -p codesigning
SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# A keychain profile created once with:
#   xcrun notarytool store-credentials "<name>" \
#     --apple-id <your-apple-id> --team-id <TEAMID> --password <app-specific-password>
NOTARY_PROFILE="copas"
