RECORD TYPE Clip (
    "___createTime" TIMESTAMP,
    "___createdBy" REFERENCE,
    "___etag" STRING,
    "___modTime" TIMESTAMP,
    "___modifiedBy" REFERENCE,
    "___recordID" REFERENCE QUERYABLE,
    blobAsset ASSET,
    byteSize INT64,
    charCount INT64,
    clipCreatedAt DOUBLE,
    contentHash STRING,
    htmlAsset ASSET,
    inlineText STRING,
    isInline INT64,
    isPinned INT64,
    kind INT64,
    pixelHeight INT64,
    pixelWidth INT64,
    preview STRING,
    recognizedAt DOUBLE,
    recognizedText STRING,
    rtfAsset ASSET,
    sourceAppName STRING,
    sourceBundleID STRING,
    GRANT WRITE TO "_creator",
    GRANT READ TO "_world"
);
